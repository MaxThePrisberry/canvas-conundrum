# Applies to backend builds (context: . in docker-compose.yml).
# The frontend has its own dockerignore at frontend/.dockerignore since
# its build context is ./frontend.
.git
.github
**/node_modules
frontend
# Runtime-mounted content — never baked into the image, so keep it out of
# the build context.
assets
trivia
game-config.json
**/*.log
**/dist
**/build
docker-compose*.yml
*.md
!backend/**/*.md
